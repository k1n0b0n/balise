# Written by ansible/server.yml (ADR-0019). APP_KEY and DB_PASSWORD were generated on this server and never leave it.
APP_NAME=balise
APP_ENV=production
APP_KEY={{ app_key }}
APP_DEBUG=false
APP_URL={{ app_url }}
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=balise
DB_USERNAME=balise
DB_PASSWORD={{ db_password }}

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
