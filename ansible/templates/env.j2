# Written by ansible/host.yml (ADR-0020 point 5) for the app containers. APP_KEY and DB_PASSWORD were generated on
# this host and never leave it.
APP_NAME=balise
APP_ENV=production
APP_KEY={{ app_key }}
APP_DEBUG=false
APP_URL={{ app_url }}
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Containers log to Docker: `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=balise
DB_USERNAME=balise
DB_PASSWORD={{ db_password }}

SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Feed recordings (E5.1, ADR-0022), in the compose file's volumes.
RECORDINGS_ENABLED={{ 'true' if recordings else 'false' }}
RECORDINGS_ARCHIVE_AT={{ recordings_archive_at }}

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log
