# Written by ansible/server.yml: the command of the {{ item.name }} service of compose.yaml (ADR-0007, ADR-0019).
[Unit]
Description=balise {{ item.description }}
After=network-online.target postgresql.service
Wants=network-online.target
# Waits for the first deploy.
ConditionPathExists=/var/www/balise/artisan

[Service]
User=balise
Group=balise
WorkingDirectory=/var/www/balise
ExecStart=/usr/bin/php artisan {{ item.command }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
